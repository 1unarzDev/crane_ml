{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crane.course_truth/2",
  "title": "crane course truth v2 (a superset of crane-roboboat-course-truth-v1)",
  "type": "object",
  "required": ["schema", "schema_version", "name", "frame", "startX", "startY", "startYaw", "family", "handbook",
               "generator", "course_frame", "boundary", "shore", "side", "vessel", "label_mode", "elements", "gates",
               "bays", "tasks", "states", "constraints"],
  "properties": {
    "schema": {"const": "crane-roboboat-course-truth-v1"},
    "schema_version": {"const": 2},
    "frame": {"const": "world"},
    "family": {"type": "string"},
    "handbook": {"type": "object", "required": ["id", "sha256"]},
    "generator": {"type": "object", "required": ["seed", "mode", "overrides", "family_sha256", "attempts", "crane_commit", "truth_sha256"],
                  "properties": {"identity": {"type": "object", "description": "Tools/RoboBoat/cli/README.md; identity version 1, absent in older truths",
                                              "required": ["version", "seed", "options", "generator", "truth_sha256", "pair_key"],
                                              "properties": {"options": {"type": "object", "required": ["family", "mode", "set"]},
                                                             "generator": {"type": "object", "required": ["crane_commit", "crane_dirty", "source_sha256"]}}}}},
    "course_frame": {"type": "object", "required": ["x", "y", "yaw"]},
    "geodetic_origin": {"type": ["object", "null"]},
    "boundary": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3},
    "shore": {"type": "array", "items": {"$ref": "#/$defs/point"}},
    "side": {"enum": ["port", "starboard"]},
    "vessel": {"type": "object", "required": ["beam", "length", "turn_radius", "source"]},
    "label_mode": {"enum": ["oracle", "camera"]},
    "elements": {"type": "array", "items": {
      "type": "object",
      "required": ["task", "label", "template", "x", "y", "radius", "id", "role", "kind", "z", "yaw", "height", "state"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "radius": {"type": "number", "minimum": 0},
                     "state": {"type": ["string", "null"]}, "length": {"type": "number"}, "width": {"type": "number"}}}},
    "gates": {"type": "array", "items": {"type": "object",
      "required": ["id", "task", "port", "starboard", "order", "x", "y", "cc", "clear", "normal_yaw"]}},
    "bays": {"type": "array", "items": {"type": "object",
      "required": ["dock", "index", "x", "y", "yaw", "width", "depth", "banner", "occupied", "id", "pier", "slip", "sign", "indicator", "vessel"],
      "properties": {"pier": {"enum": ["N", "S"]}, "slip": {"enum": [1, 2, 3]}, "occupied": {"type": "boolean"}}}},
    "tasks": {"type": "array", "items": {"type": "object",
      "required": ["id", "type", "cite", "params", "anchors", "footprint", "semantics"]}},
    "states": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "initial", "program"]}},
    "constraints": {"type": "array", "items": {"type": "object", "required": ["id", "tag", "pass", "value", "limit"]}}
  },
  "$defs": {"point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}
}
