#!/bin/sh
# sim_up: the old name of `crane sim` (crane/sim/), kept for astro's sim profile (astro.sim) and scripts.
#   sim_up [up] [ARGS...] | down | status | check [--wait S] | logs    (bare, or options only: up)
# Every argument and the environment go to `crane sim` unchanged; see `crane sim --help`.
here=$(cd "$(dirname "$0")" && pwd)
crane=$(cd "$here/../.." && pwd)
[ -t 2 ] && echo "sim_up: this is now 'crane sim'; sim_up stays as its alias" >&2
case ${1:-} in
  '') set -- up ;;
  -h|--help) shift; set -- help "$@" ;;
  -*) set -- up "$@" ;;
esac
if [ -x "$crane/bin/crane" ]; then exec "$crane/bin/crane" sim "$@"; fi
# this checkout's crane first on sys.path, ahead of the working directory (python3 -m would put it first)
exec python3 -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from crane.cli import main; sys.exit(main())' \
  "$crane" sim "$@"
