#!/usr/bin/env bash
# sim_up: start the simulated RoboBoat world, so the sim is used exactly like the boat.
#
# The backend of `astro sim up|down|status` (the sim profile's astro.sim), which exports ROS_DOMAIN_ID,
# ASTRO_DATA and the state path (ASTRO_STATE / MHSEALS_HARDWARE_CONFIG); run bare, it reads the sim profile.
#
#   sim_up [up] [--seed N] [--course FAMILY] [--profile-json F] [--window | --headless] [--player PATH]
#   sim_up down      stop what sim_up started (its player and its ROS container only)
#   sim_up status    the status block: mode, domain, port, pids, logs, the next commands
#
# up starts two things and returns once the course is ready:
#   1. the ROS side: `ros2 launch mhseals_nav device.launch.py device:=sim` (odometry, EKFs, nav, objects
#      and the ROS-TCP endpoint) in its own container (sim_up_ros) on the workspace's dev image, host
#      network and host IPC like the dev container, on the sim vessel's ROS_DOMAIN_ID. `astro on sim`
#      works inside it: the workspace, ~/.config/mhseals and ~/.config/astro are mounted as in the dev container;
#   2. the crane_ml player (--crane-disable-sitl --crane-ros-thruster-pwm --crane-roboboat-contract
#      --crane-ros-nav-state) connected to that endpoint on port 10000 + domain, always through the host
#      heavy guard (`heavy unity`).
#   --window shows the player on your display (interactive-low); --headless runs it under xvfb-run.
#   Default: --window when stdin is a terminal and DISPLAY or WAYLAND_DISPLAY is set, else --headless,
#   so agents and scripts stay headless.
# Then, as on the boat:
#   astro on sim
#   ros2 launch mhseals_hardware drive.launch.py output_backend:=topic use_sim_time:=true
#   astro rec start ... / astro test ... / astro trial ...
#
# Settings (environment): ROS_DOMAIN_ID (from astro), ASTRO_DOCK (default ~/astro_dock), ASTRO_PROFILES (else ~/.config/astro/profiles.env,
# else $ASTRO_DOCK/profiles), SIM_UP_VESSEL (sim), CRANE_PLAYER (a player with the flags above), HEAVY (the
# heavy guard, default crane's bin/heavy; none runs bare on purpose), ASTRO_IMAGE (else the dev compose default), SIM_UP_READY_S (300).
# Runtime files: ~/.cache/sim_up (pids, logs, course truth). Never kills a tmux server or another container.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
crane=$(cd "$here/../.." && pwd)
RUN=${SIM_UP_RUN:-$HOME/.cache/sim_up}
DOCK=${ASTRO_DOCK:-$HOME/astro_dock}
VESSEL=${SIM_UP_VESSEL:-sim}
CONTAINER=sim_up_ros
READY_S=${SIM_UP_READY_S:-300}
WS=/home/roboboat/roboboat_ws            # the dev container's workspace mount (.devcontainer/docker-compose.yml)

die() { echo "sim_up: $*" >&2; exit 2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//p}' "$0"; }

profiles_root() {
  local env=${ASTRO_PROFILES_CONFIG:-$HOME/.config/astro/profiles.env} p=${ASTRO_PROFILES:-}
  [ -n "$p" ] || p=$(sed -n 's/^ASTRO_PROFILES=//p' "$env" 2>/dev/null | tail -n1)
  p=${p/#\~/$HOME}
  printf '%s' "${p:-$DOCK/profiles}"
}

domain() {   # astro exports the vessel's ROS_DOMAIN_ID; run bare, the sim profile's network.env (never guessed)
  if [ -n "${ROS_DOMAIN_ID:-}" ] && [ -n "${ASTRO_STATE:-}${MHSEALS_HARDWARE_CONFIG:-}" ]; then
    printf '%s' "$ROS_DOMAIN_ID"; return     # a bare shell's ROS_DOMAIN_ID may be a boat's: only astro's counts
  fi
  local f; f=$(profiles_root)/$VESSEL/network.env
  [ -r "$f" ] || die "no $f: the $VESSEL vessel profile names the sim's ROS_DOMAIN_ID (or run it as astro sim up)"
  local d; d=$(sed -n 's/^ROS_DOMAIN_ID=\([0-9]*\).*/\1/p' "$f" | tail -n1)
  [ -n "$d" ] || die "$f has no ROS_DOMAIN_ID"
  printf '%s' "$d"
}

has_flags() {  # the player's assemblies know the RoboBoat contract flags
  local dir; dir=$(dirname "$1")
  ( set +o pipefail
    for f in "$dir"/*_Data/Managed/*.dll; do strings -a -el "$f"; done 2>/dev/null | grep -q -- --crane-roboboat-contract )
}

find_player() {
  local c
  for c in ${CRANE_PLAYER:-} "$crane/Builds/CRANE-Worker/CRANE.x86_64" "$HOME/.cache/crane-phase1/player/CRANE.x86_64"; do
    [ -x "$c" ] && has_flags "$c" && { printf '%s' "$c"; return; }
  done
  die "no player with --crane-roboboat-contract (tried ${CRANE_PLAYER:-} $crane/Builds/CRANE-Worker, ~/.cache/crane-phase1/player); build one or set CRANE_PLAYER=/path/CRANE.x86_64"
}

image() {
  [ -n "${ASTRO_IMAGE:-}" ] && { printf '%s' "$ASTRO_IMAGE"; return; }
  sed -n 's/.*\${ASTRO_IMAGE:-\([^}]*\)}.*/\1/p' "$DOCK/.devcontainer/docker-compose.yml" | head -n1
}

alive() { [ -s "$RUN/$1.pid" ] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
ros_up() { [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = true ]; }

status() {
  local d p; d=$(cat "$RUN/domain" 2>/dev/null || true); p=$(cat "$RUN/port" 2>/dev/null || true)
  echo "sim_up status"
  echo "  mode:      $(cat "$RUN/mode" 2>/dev/null || echo -)"
  echo "  vessel:    $VESSEL   ROS_DOMAIN_ID ${d:--}   endpoint 127.0.0.1:${p:--}"
  if alive player; then echo "  player:    running, pgid $(cat "$RUN/player.pid") ($(cat "$RUN/player.path" 2>/dev/null))"
  else echo "  player:    stopped"; fi
  if ros_up; then echo "  ros:       container $CONTAINER running (device.launch.py device:=sim)"
  else echo "  ros:       stopped"; fi
  grep -q CRANE_ROBOBOAT_COURSE_READY "$RUN/player.log" 2>/dev/null && echo "  course:    ready (seed $(cat "$RUN/seed" 2>/dev/null), truth $RUN/course_truth.json)"
  echo "  logs:      $RUN/player.log  $RUN/player-stdout.log  $RUN/ros.log"
  if alive player || ros_up; then
    echo "  next:      astro on sim"
    echo "             ros2 launch mhseals_hardware drive.launch.py output_backend:=topic use_sim_time:=true"
    echo "             astro rec start ... ; astro test ... ; astro trial ...   (astro sim down when done)"
  else
    echo "  next:      astro sim up"
  fi
}

down() {
  if [ -s "$RUN/player.pid" ]; then           # its own process group (setsid): heavy, xvfb-run, the player
    local pg; pg=$(cat "$RUN/player.pid")
    kill -TERM -- "-$pg" 2>/dev/null || true
    for _ in $(seq 20); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.5; done
    kill -KILL -- "-$pg" 2>/dev/null || true
    rm -f "$RUN/player.pid"
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  rm -f "$RUN/domain" "$RUN/port"
  echo "sim_up: down"
}

up() {
  local seed=1 course=roboboat_2026 profile_json='' mode='' player=''
  while [ $# -gt 0 ]; do
    case $1 in
      --seed) seed=$2; shift 2 ;;
      --course) course=$2; shift 2 ;;
      --profile-json) profile_json=$(realpath -e "$2") || die "no $2"; shift 2 ;;
      --window) mode=window; shift ;;
      --headless) mode=headless; shift ;;
      --player) CRANE_PLAYER=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option $1 (sim_up --help)" ;;
    esac
  done
  if [ -z "$mode" ]; then
    if [ -t 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then mode=window; else mode=headless; fi
  fi
  if alive player || ros_up; then status; die "already up; sim_up down first"; fi
  local heavy=${HEAVY:-} guard=()
  [ -n "$heavy" ] || { heavy=$crane/bin/heavy; [ -x "$heavy" ] || heavy=$DOCK/.handoff/tools/heavy; }   # crane owns the guard
  if [ "$heavy" != none ]; then [ -x "$heavy" ] || die "no heavy guard at $heavy (HEAVY=none runs bare)"; guard=("$heavy" unity); fi
  player=$(find_player)
  local d img port; d=$(domain); port=$((10000 + d)); img=$(image)
  [ -n "$img" ] || die "no dev image (ASTRO_IMAGE)"
  mkdir -p "$RUN"; rm -f "$RUN"/player*.log "$RUN/ros.log" "$RUN/course_truth.json"
  echo "$d" >"$RUN/domain"; echo "$port" >"$RUN/port"; echo "$mode" >"$RUN/mode"; echo "$seed" >"$RUN/seed"
  echo "$player" >"$RUN/player.path"

  # 1. the ROS side: device:=sim with its endpoint on this port, logged to RUN
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  # astro on sim works in this container like in the boat's dev container: the state (~/.config/mhseals, which
  # astro apply writes), the operator config, the workspace (tools/bin/astro on PATH via dev.bashrc, the data dir)
  mkdir -p "$HOME/.config/mhseals" "$HOME/.config/astro" "$DOCK/bags/sim"
  local overrides="{\"parts\": {\"sensors\": {\"args\": {\"ros_port\": \"$port\"}}}}"
  docker run -d --name "$CONTAINER" --label sim_up=1 --init --network host --ipc host --user roboboat \
    -e ROS_DOMAIN_ID="$d" -e ROS_WS="$WS" -e BASH_ENV="$WS/.devcontainer/dev.bashrc" \
    -e FASTRTPS_DEFAULT_PROFILES_FILE="$WS/config/fastdds.xml" -e FASTDDS_DEFAULT_PROFILES_FILE="$WS/config/fastdds.xml" \
    -v "$DOCK:$WS" -v "$RUN:$RUN" -w "$WS" \
    -v "$HOME/.config/mhseals:/home/roboboat/.config/mhseals" -v "$HOME/.config/astro:/home/roboboat/.config/astro" \
    --entrypoint bash "$img" \
    -c "exec ros2 launch mhseals_nav device.launch.py device:=sim overrides:='$overrides' >$RUN/ros.log 2>&1" >/dev/null
  echo "sim_up: ROS side starting (domain $d, endpoint port $port, log $RUN/ros.log)"
  local waited=0
  until ss -ltn "sport = :$port" | grep -q LISTEN; do
    ros_up || { tail -n 20 "$RUN/ros.log" >&2; die "the ROS side exited, see $RUN/ros.log"; }
    [ "$waited" -ge 60 ] && die "no endpoint on port $port in 60 s, see $RUN/ros.log"
    sleep 1; waited=$((waited + 1))
  done

  # 2. the player, through heavy unity, in its own process group
  local view=(env SDL_VIDEODRIVER=x11)  # the owner's display (XWayland under Wayland)
  # headless: only xvfb's display; without WAYLAND_DISPLAY unset, SDL would pick Wayland and open a window
  [ "$mode" = headless ] && view=(env -u WAYLAND_DISPLAY SDL_VIDEODRIVER=x11 xvfb-run -a -s "-screen 0 1280x720x24")
  local args=(-screen-fullscreen 0 -screen-width 1280 -screen-height 720 -logFile "$RUN/player.log"
    --crane-profile interactive-low --crane-scene "Roboboat Course"
    --crane-ros-ip 127.0.0.1 --crane-ros-port "$port"
    --crane-disable-sitl --crane-ros-thruster-pwm --crane-roboboat-contract --crane-ros-nav-state
    --crane-lidar-returns-only --crane-lidar-water-level 0.02
    --crane-course-family "$course" --crane-course-seed "$seed"
    --crane-roboboat-course-truth "$RUN/course_truth.json")
  [ -n "$profile_json" ] && args+=(--crane-boat-profile-json "$profile_json")
  HEAVY_WHO="sim_up $mode" setsid "${guard[@]}" "${view[@]}" nice -n 10 "$player" "${args[@]}" \
    >"$RUN/player-stdout.log" 2>&1 </dev/null &
  echo $! >"$RUN/player.pid"
  echo "sim_up: player queued on heavy unity ($mode), waiting up to $READY_S s for the course"
  waited=0
  until grep -q CRANE_ROBOBOAT_COURSE_READY "$RUN/player.log" 2>/dev/null; do
    alive player || { tail -n 20 "$RUN/player-stdout.log" >&2; down; die "the player exited, see $RUN/player.log"; }
    [ "$waited" -ge "$READY_S" ] && { down; die "course not ready in $READY_S s, see $RUN/player.log and $RUN/player-stdout.log"; }
    sleep 2; waited=$((waited + 2))
  done
  status
}

verb=${1:-up}
case $verb in
  up) shift || true; up "$@" ;;
  --*) up "$@" ;;
  down) down ;;
  status) status ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
