#!/usr/bin/env python3
"""Turn an `astro bundle` into a crane boat profile JSON for `sim_up --profile-json` (bundle.py reads it).

    Tools/Characterization/from_bundle BUNDLE.tgz --out profile.json [--report gate.json] [--base ideal.json]

The gate's inputs come from what the bundle records and nothing else (bundle.py says what from where). Then
import_yaml.py runs: parameters the gate identifies or marks provisional overwrite the base (Ideal); the rest
stay prior. It prints each parameter's status and reason. The derived inputs stay beside the profile
(<out>.inputs/). `crane fit` runs the same import and adds the plant-card fit.
"""
from __future__ import annotations

import argparse
import os
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bundle as B  # noqa: E402
import gate as G  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("bundle")
    ap.add_argument("--out", required=True, help="boat profile JSON to write")
    ap.add_argument("--report", help="gate report JSON (default <out>.gate.json)")
    ap.add_argument("--base", default=None, help="base profile (default Ideal)")
    a = ap.parse_args(argv)
    with tempfile.TemporaryDirectory(prefix="from_bundle-") as tmp:
        b = B.open_bundle(a.bundle, tmp)
        if not (G.characterization_block(b.state) or {}).get("speed_curves"):
            sys.exit(f"from_bundle: {b.state_path.name if b.state_path else 'the bundle'} has no "
                     "characterization.speed_curves; run and apply astro test speed-*")
        prof, _, notes = B.import_profile(b, a.out, a.report, a.base)
    for note in notes:
        print(f"  note: {note}")
    for p in prof["provenance"]["parameters"]:
        if p["name"] in G.DIRECTIONS or p["name"].startswith("addedMass."):
            print(f"  {p['name']:<14} {p['status']:<11} {p['reason']}")
    print(f"from_bundle: wrote {Path(a.out).resolve()} (sim_up --profile-json {Path(a.out).resolve()})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
