{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRANE calibration profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "sourceKind", "parameters", "fitProvenance"],
  "properties": {
    "schema": {"const": "crane-calibration-profile-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sourceKind": {"enum": ["physical", "synthetic-fixture"]},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["massKg", "motorLagSeconds", "accelerationMps2", "angularAccelerationRadPerSec2", "maxMotorTorqueNm", "leftWheelScale", "rightWheelScale", "lidar"],
      "properties": {
        "massKg": {"type": "number", "minimum": 0.5, "maximum": 5},
        "motorLagSeconds": {"type": "number", "minimum": 0.001, "maximum": 2},
        "accelerationMps2": {"type": "number", "minimum": 0.0001, "maximum": 3},
        "angularAccelerationRadPerSec2": {"type": "number", "minimum": 0.0001, "maximum": 20},
        "maxMotorTorqueNm": {"type": "number", "minimum": 0.0001, "maximum": 2},
        "leftWheelScale": {"type": "number", "minimum": 0.9, "maximum": 1.1},
        "rightWheelScale": {"type": "number", "minimum": 0.9, "maximum": 1.1},
        "lidar": {
          "type": "object", "additionalProperties": false,
          "required": ["sigmaMeters", "dropoutProbability", "latencyScans", "materialClass"],
          "properties": {
            "sigmaMeters": {"type": "number", "minimum": 0, "maximum": 0.1},
            "dropoutProbability": {"type": "number", "minimum": 0, "maximum": 0.5},
            "latencyScans": {"type": "integer", "minimum": 0, "maximum": 3},
            "materialClass": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "fitProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["trialIds", "manifestSha256", "fitNote"],
      "properties": {
        "trialIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "manifestSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "fitNote": {"type": "string", "minLength": 1}
      }
    }
  }
}
