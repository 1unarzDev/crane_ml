# Alternative to compose: the coordinator as a systemd user service on the host's own Node (>= 24).
#   install: cluster/server/deploy/install-systemd.sh (copies dist/ to ~/crane-server/app, this unit to
#   ~/.config/systemd/user/, then `systemctl --user enable --now crane-server`; `loginctl enable-linger` keeps it
#   running without a login). Settings and secrets: ~/crane-server/.env (mode 600), same keys as compose.
[Unit]
Description=crane cluster coordinator (self-hosted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/crane-server/app
EnvironmentFile=%h/crane-server/.env
Environment=CRANE_DATA_DIR=%h/crane-server/data HOST=127.0.0.1 PORT=8787 NODE_ENV=production
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning --enable-source-maps main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=768M
Nice=5

[Install]
WantedBy=default.target
