+  id: string;
+  token_sha256: string;
+  name: string;
+  caps_json: string;
+  policy_json: string;
+  client_version: string | null;
+  state: string | null;
+  stats_json: string | null;
+  last_seen: string | null;
+  disabled: number;
+}
+type MemJob = JobRow & Record<string, unknown> & { hyp_name?: string | null };
+interface MemRun {
+  job_id: string;
+  attempt: number;
+  status: string;
+  metrics: Record<string, number>;
+}
+/** A route's answer as JSON text, so HttpErrors survive the RPC boundary. */
+export interface HubRes {
+  status: number;
+  body: string;
+}
+const res = (body: unknown, status = 200): HubRes => ({ status, body: JSON.stringify(body) });
+interface Memo {
+  val: unknown;
+  at: number;
+  hv: number;
+}
