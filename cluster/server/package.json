{
  "name": "crane-cluster-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The crane coordinator self-hosted: the Worker's code on Node with SQLite, a pluggable artifact store and an in-process Hub",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-core": "node scripts/prepare.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/prepare.mjs && vitest run",
    "test:http": "node scripts/prepare.mjs && CRANE_TEST_HTTP=1 vitest run",
    "start": "node --disable-warning=ExperimentalWarning dist/main.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "vitest": "~4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
