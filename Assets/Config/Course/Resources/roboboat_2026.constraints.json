{
  "schema": "crane.course_constraints/1",
  "family": "roboboat_2026",
  "notes": "Single source for the C# ConstraintEvaluator and Tools/RoboBoat/validate.py. tag H = handbook (page), D = our design choice (hard in the generator, reported separately). Limits are {min, max} or {in}; a negative tol makes a bound strict. plus_beam adds truth vessel.beam to min. Rows with final run once the whole course exists.",
  "rows": [
    {"id": "G1.inside", "task": "course", "tag": "D", "cite": "course area", "predicate": "inside", "args": {}, "limit": {"min": 0}},
    {"id": "G2.clearance", "task": "course", "tag": "D", "cite": "1 m between objects outside a structure", "predicate": "clearance",
     "args": {"exclude_roles": ["vessel", "dock_sign", "dock_indicator", "slip_hull", "marker_on_mark"]}, "limit": {"min": 1.0}},
    {"id": "G3.start_clear", "task": "course", "tag": "D", "cite": "nothing within 1.5 m of the start", "predicate": "distance",
     "args": {"a": "anchor:entry_gates.start", "select": {}}, "limit": {"min": 1.5}},
    {"id": "G4.no_overlap", "task": "course", "tag": "D", "cite": "task footprints", "predicate": "no_overlap", "args": {}, "limit": {"max": 0}},
    {"id": "P5.anchors", "task": "course", "tag": "D", "cite": "T1 exit to every task and back", "predicate": "path",
     "args": {"kind": "anchors", "ignore_roles": ["dock_sign", "dock_indicator"], "from": "anchor:entry_gates.exit", "anchor": "approach"}, "limit": {"min": 1}},

    {"id": "T1.count", "task": "entry_gates", "tag": "H", "cite": "p.45 two gates", "predicate": "count",
     "args": {"select": {"collection": "gates", "task": "entry_gates"}}, "limit": {"min": 2, "max": 2}},
    {"id": "T1.side", "task": "entry_gates", "tag": "H", "cite": "p.45 red to port", "predicate": "gate_side",
     "args": {"select": {"collection": "gates", "task": "entry_gates"}, "port_color": "red"}, "limit": {"min": 0.001}},
    {"id": "T1.cc", "task": "entry_gates", "tag": "H", "cite": "p.46 6-10 ft (c-c, D)", "predicate": "gate_cc",
     "args": {"select": {"collection": "gates", "task": "entry_gates"}}, "limit": {"min": 1.83, "max": 3.05}, "tol": 0.002},
    {"id": "T1.clear", "task": "entry_gates", "tag": "D", "cite": "clear >= beam + 0.3", "predicate": "gate_clear",
     "args": {"select": {"collection": "gates", "task": "entry_gates"}, "plus_beam": true}, "limit": {"min": 0.3}},
    {"id": "T1.separation", "task": "entry_gates", "tag": "H", "cite": "p.45 25-100 ft", "predicate": "distance",
     "args": {"a": "gate:entry_gates.gate1", "b": "gate:entry_gates.gate2"}, "limit": {"min": 7.62, "max": 30.48}, "tol": 0.002},
    {"id": "T1.standoff", "task": "entry_gates", "tag": "H", "cite": "p.45 >= 6 ft before gate 1", "predicate": "along",
     "args": {"gate": "gate:entry_gates.gate1", "point": "anchor:entry_gates.start"}, "limit": {"max": -1.83}, "tol": 0.002},
    {"id": "T1.gate2_yaw", "task": "entry_gates", "tag": "D", "cite": "gate 2 within 15 deg", "predicate": "angle_between",
     "args": {"a": "gate:entry_gates.gate1", "b": "gate:entry_gates.gate2"}, "limit": {"max": 15}, "tol": 0.01},

    {"id": "T2.count", "task": "debris_clearance", "tag": "D", "cite": "2-5 channel gates", "predicate": "count",
     "args": {"select": {"collection": "gates", "task": "debris_clearance"}}, "limit": {"min": 2, "max": 5}},
    {"id": "T2.side", "task": "debris_clearance", "tag": "H", "cite": "p.48 red to port outbound", "predicate": "gate_side",
     "args": {"select": {"collection": "gates", "task": "debris_clearance"}, "port_color": "red"}, "limit": {"min": 0.001}},
    {"id": "T2.cc", "task": "debris_clearance", "tag": "H", "cite": "p.48 6-10 ft (c-c, D)", "predicate": "gate_cc",
     "args": {"select": {"collection": "gates", "task": "debris_clearance"}}, "limit": {"min": 1.83, "max": 3.05}, "tol": 0.002},
    {"id": "T2.clear", "task": "debris_clearance", "tag": "D", "cite": "clear >= beam + 0.3", "predicate": "gate_clear",
     "args": {"select": {"collection": "gates", "task": "debris_clearance"}, "plus_beam": true}, "limit": {"min": 0.3}},
    {"id": "T2.after_entry", "task": "debris_clearance", "tag": "D", "cite": "first gate past T1 gate 2", "predicate": "along",
     "args": {"gate": "gate:entry_gates.gate2", "point": "gate:debris_clearance@first"}, "limit": {"min": 2.9}},
    {"id": "T2.heading", "task": "debris_clearance", "tag": "D", "cite": "channel heading within 15 deg of T1 gate 2 (continuity)", "predicate": "angle_between",
     "args": {"a": "gate:entry_gates.gate2", "b": "gate:debris_clearance@first"}, "limit": {"max": 15}, "tol": 0.01},
    {"id": "T2.bend", "task": "debris_clearance", "tag": "D", "cite": "curvature <= 0.04 1/m, gate to gate from the posts (0.5e-3 for 1 mm rounding)", "predicate": "curvature",
     "args": {"select": {"collection": "gates", "task": "debris_clearance"}}, "limit": {"max": 0.04}, "tol": 0.0005},
    {"id": "T2.field_beyond", "task": "debris_clearance", "tag": "D", "cite": "field beyond the last gate, none in the corridor", "predicate": "along",
     "args": {"gate": "gate:debris_clearance@last", "select": {"task": "debris_clearance", "role": ["debris", "beacon"]}}, "limit": {"min": 1.0}},
    {"id": "T2.black", "task": "debris_clearance", "tag": "H", "cite": "p.47 >= 1 black", "predicate": "count",
     "args": {"select": {"task": "debris_clearance", "role": "debris"}}, "limit": {"min": 1}},
    {"id": "T2.red", "task": "debris_clearance", "tag": "H", "cite": "p.47 >= 1 red beacon", "predicate": "count",
     "args": {"select": {"task": "debris_clearance", "role": "beacon", "where": {"label": "red_light_buoy"}}}, "limit": {"min": 1}},
    {"id": "T2.green", "task": "debris_clearance", "tag": "H", "cite": "p.47 >= 1 green beacon", "predicate": "count",
     "args": {"select": {"task": "debris_clearance", "role": "beacon", "where": {"label": "green_light_buoy"}}}, "limit": {"min": 1}},
    {"id": "P1.channel", "task": "debris_clearance", "tag": "D", "cite": "through every channel gate in order and back", "predicate": "path",
     "args": {"kind": "channel", "ignore_roles": ["dock_sign", "dock_indicator"], "select": {"collection": "gates", "task": "debris_clearance"}}, "limit": {"min": 1}},
    {"id": "P3.rescue_circle", "task": "debris_clearance", "tag": "D", "cite": "360 deg at turn_radius + beam round every green beacon", "predicate": "path",
     "args": {"kind": "circle", "ignore_roles": ["dock_sign", "dock_indicator"], "select": {"task": "debris_clearance", "role": "beacon", "where": {"label": "green_light_buoy"}}}, "limit": {"min": 1}},

    {"id": "T3.count", "task": "speed_challenge", "tag": "H", "cite": "p.49 one gate", "predicate": "count",
     "args": {"select": {"collection": "gates", "task": "speed_challenge"}}, "limit": {"min": 1, "max": 1}},
    {"id": "T3.side", "task": "speed_challenge", "tag": "H", "cite": "p.49 red to port", "predicate": "gate_side",
     "args": {"select": {"collection": "gates", "task": "speed_challenge"}, "port_color": "red"}, "limit": {"min": 0.001}},
    {"id": "T3.cc", "task": "speed_challenge", "tag": "H", "cite": "p.50 6-10 ft (c-c, D)", "predicate": "gate_cc",
     "args": {"select": {"collection": "gates", "task": "speed_challenge"}}, "limit": {"min": 1.83, "max": 3.05}, "tol": 0.002},
    {"id": "T3.clear", "task": "speed_challenge", "tag": "D", "cite": "clear >= beam + 0.3", "predicate": "gate_clear",
     "args": {"select": {"collection": "gates", "task": "speed_challenge"}, "plus_beam": true}, "limit": {"min": 0.3}},
    {"id": "T3.leg", "task": "speed_challenge", "tag": "H", "cite": "p.50 mark 40-100 ft along the gate normal", "predicate": "along",
     "args": {"gate": "gate:speed_challenge.gate", "point": "elem:speed_challenge.mark"}, "limit": {"min": 12.19, "max": 30.48}, "tol": 0.002},
    {"id": "T3.lateral", "task": "speed_challenge", "tag": "D", "cite": "mark within 3 m of the gate normal", "predicate": "lateral",
     "args": {"gate": "gate:speed_challenge.gate", "point": "elem:speed_challenge.mark"}, "limit": {"max": 3}, "tol": 0.002},
    {"id": "T3.marker_between", "task": "speed_challenge", "tag": "L", "cite": "Jan 14 marker between gate and mark", "predicate": "along",
     "when": {"select": {"collection": "tasks", "task": "speed_challenge"}, "path": "params.marker_variant", "equals": "separate"},
     "args": {"gate": "gate:speed_challenge.gate", "point": "elem:speed_challenge.marker", "relative_to": "elem:speed_challenge.mark"},
     "limit": {"min": 0, "max": 1}, "tol": -0.001},
    {"id": "T3.sign", "task": "speed_challenge", "tag": "H", "cite": "p.49 one light sign", "predicate": "count",
     "args": {"select": {"task": "speed_challenge", "role": "light_sign"}}, "limit": {"min": 1, "max": 1}},
    {"id": "T3.marker", "task": "speed_challenge", "tag": "L", "cite": "Jan 14 one red/green marker", "predicate": "count",
     "args": {"select": {"task": "speed_challenge", "role": ["marker", "marker_on_mark"]}}, "limit": {"min": 1, "max": 1}},
    {"id": "T3.direction_marker", "task": "speed_challenge", "tag": "H", "cite": "p.49 red ccw, green cw, from the marker's state", "predicate": "state_map",
     "when": {"select": {"collection": "tasks", "task": "speed_challenge"}, "path": "semantics.direction_source", "equals": "marker"},
     "args": {"elem": "speed_challenge.marker", "map": {"red": "ccw", "green": "cw"}, "select": {"collection": "tasks", "task": "speed_challenge"}, "path": "semantics.direction"}, "limit": {"max": 0}},
    {"id": "T3.direction_sign", "task": "speed_challenge", "tag": "H", "cite": "p.49 red ccw, green cw, from the sign's state at t=0", "predicate": "state_map",
     "when": {"select": {"collection": "tasks", "task": "speed_challenge"}, "path": "semantics.direction_source", "equals": "sign"},
     "args": {"elem": "speed_challenge.sign", "map": {"red": "ccw", "green": "cw"}, "select": {"collection": "tasks", "task": "speed_challenge"}, "path": "semantics.direction"}, "limit": {"max": 0}},
    {"id": "T3.beyond_gate2", "task": "speed_challenge", "tag": "D", "cite": "gate beyond entry gate 2 along course progression (H p.40 map)", "predicate": "along",
     "args": {"gate": "gate:entry_gates.gate2", "point": "gate:speed_challenge.gate"}, "limit": {"min": 3.0}, "tol": 0.002},
    {"id": "T3.approach_exit", "task": "speed_challenge", "tag": "D", "cite": "gate faces the approach from the channel exit within 60 deg (H p.40 map)", "predicate": "facing",
     "args": {"gate": "gate:speed_challenge.gate", "from": "anchor:debris_clearance.exit"}, "limit": {"max": 60}, "tol": 0.01},
    {"id": "T3.approach_gate2", "task": "speed_challenge", "tag": "D", "cite": "gate faces the approach from entry gate 2 within 60 deg (H p.40 map)", "predicate": "facing",
     "args": {"gate": "gate:speed_challenge.gate", "from": "gate:entry_gates.gate2"}, "limit": {"max": 60}, "tol": 0.01},
    {"id": "T3.gate_free", "task": "speed_challenge", "tag": "D", "cite": "no obstacle in the gate", "predicate": "clearance",
     "args": {"select": {"task": "speed_challenge"}, "gates": {"collection": "gates", "task": "speed_challenge"}}, "limit": {"min": 1.0}},
    {"id": "P2.loop", "task": "speed_challenge", "tag": "D", "cite": "gate, round the mark, gate", "predicate": "path",
     "args": {"kind": "loop", "ignore_roles": ["dock_sign", "dock_indicator"], "select": {"collection": "gates", "task": "speed_challenge"}, "mark": {"task": "speed_challenge", "role": "mark"}}, "limit": {"min": 1}},

    {"id": "T4.water", "task": "supply_drop", "tag": "H", "cite": "p.51 <= 3 water hulls", "predicate": "count",
     "args": {"select": {"task": "supply_drop", "kind_prefix": "roboboat/hull_water"}}, "limit": {"max": 3}},
    {"id": "T4.ball", "task": "supply_drop", "tag": "H", "cite": "p.51 <= 3 ball hulls", "predicate": "count",
     "args": {"select": {"task": "supply_drop", "kind_prefix": "roboboat/hull_ball"}}, "limit": {"max": 3}},
    {"id": "T4.gates", "task": "supply_drop", "tag": "D", "cite": ">= 3 m from gate segments", "predicate": "clearance",
     "args": {"select": {"task": "supply_drop"}, "gates": {"collection": "gates"}}, "limit": {"min": 3.0}},
    {"id": "T4.docked", "task": "supply_drop", "tag": "D", "cite": ">= 1 hull docked in a slip", "predicate": "in_bay",
     "args": {"select": {"task": "supply_drop", "kind_prefix": "roboboat/hull"}, "bays": {"collection": "bays", "task": "marina"}}, "limit": {"min": 1}},
    {"id": "T4.dock_green_free", "task": "supply_drop", "tag": "H", "cite": "p.54 a green slip never holds a stationary boat (so never the target)", "predicate": "in_bay",
     "args": {"select": {"task": "supply_drop"}, "bays": {"collection": "bays", "task": "marina", "where": {"indicator.color": "green"}}}, "limit": {"max": 0}},
    {"id": "T4.dock_moored_free", "task": "supply_drop", "tag": "D", "cite": "no hull in a slip holding a moored boat", "predicate": "in_bay",
     "args": {"select": {"task": "supply_drop"}, "bays": {"collection": "bays", "task": "marina", "where": {"occupied": true}}}, "limit": {"max": 0}},
    {"id": "T4.dock_beside_moored", "task": "supply_drop", "tag": "D", "cite": "no hull in a slip beside a moored boat on the same pier", "predicate": "in_bay",
     "args": {"select": {"task": "supply_drop"}, "bays": {"collection": "bays", "task": "marina", "where": {"occupied": true}}, "beside": true}, "limit": {"max": 0}},
    {"id": "T4.near_task", "task": "supply_drop", "tag": "D", "cite": "each free hull within 25 m of another task's object (H p.40 map: hulls among the tasks)", "predicate": "nearest",
     "args": {"select": {"task": "supply_drop", "role": "hull"}}, "limit": {"max": 25}, "tol": 0.002},
    {"id": "T4.spacing", "task": "supply_drop", "tag": "D", "cite": "free hulls >= 8 m apart", "predicate": "nearest",
     "args": {"select": {"task": "supply_drop", "role": "hull"}, "to": "selected"}, "limit": {"min": 8}, "tol": 0.002},
    {"id": "T4.scatter", "task": "supply_drop", "tag": "D", "cite": "free hulls by >= 2 different tasks (no single clump)", "predicate": "spread_tasks",
     "args": {"select": {"task": "supply_drop", "role": "hull"}, "min_tasks": 2}, "limit": {"max": 0}},
    {"id": "T4.lane", "task": "supply_drop", "tag": "D", "cite": "free hulls >= 3 m from the boat's lead-in: start, entry gates 1 and 2, every channel gate (H p.40 map)", "predicate": "polyline_distance",
     "args": {"select": {"task": "supply_drop", "role": "hull"}, "through": ["anchor:entry_gates.start", "gate:entry_gates.gate1", "gate:entry_gates.gate2"], "through_gates": "debris_clearance"}, "limit": {"min": 3}, "tol": 0.002},

    {"id": "T5.slips", "task": "marina", "tag": "H", "cite": "p.55 2 piers x 3 slips", "predicate": "count",
     "args": {"select": {"collection": "bays", "task": "marina"}}, "limit": {"min": 6, "max": 6}},
    {"id": "T5.numbers", "task": "marina", "tag": "H", "cite": "p.55 signs 1-3 unique per pier", "predicate": "unique",
     "args": {"select": {"collection": "bays", "task": "marina"}, "key": "sign.number", "group": "pier", "allowed": [1, 2, 3]}, "limit": {"max": 0}},
    {"id": "T5.antiparallel", "task": "marina", "tag": "D", "cite": "slips open toward each other", "predicate": "angle_between",
     "args": {"a": "bay:marina.N1", "b": "bay:marina.S1", "antiparallel": true}, "limit": {"max": 10}},
    {"id": "T5.tip_gap", "task": "marina", "tag": "D", "cite": "tine-tip gap >= 3 m", "predicate": "distance",
     "args": {"a": "anchor:marina.tips_N", "b": "anchor:marina.tips_S"}, "limit": {"min": 3.0}, "tol": 0.002},
    {"id": "T5.slip_clear", "task": "marina", "tag": "D", "cite": "fig 60 in +- 0.15", "predicate": "value",
     "args": {"select": {"collection": "bays", "task": "marina"}, "path": "width"}, "limit": {"min": 1.37, "max": 1.67}},
    {"id": "T5.slip_vessel", "task": "marina", "tag": "D", "cite": "slip clear >= beam + 0.3", "predicate": "value",
     "args": {"select": {"collection": "bays", "task": "marina"}, "path": "width", "plus_beam": true}, "limit": {"min": 0.3}},
    {"id": "T5.shore", "task": "marina", "tag": "D", "cite": "rooted: the shore-most spine within 2 m of the shore line", "predicate": "inside",
     "args": {"select": {"task": "marina", "role": "pier_spine"}, "edge": "shore", "reduce": "min"}, "limit": {"min": 0, "max": 2.0}, "tol": 0.002},
    {"id": "T5.yaw", "task": "marina", "tag": "D", "cite": "pier direction (spine yaw, from its shore root to its open end) within 90 deg of the shore normal: the pier never points into the shore", "predicate": "angle_between",
     "args": {"a": "elem:marina.N.spine", "b": "shore:normal"}, "limit": {"max": 90}, "tol": 0.01},
    {"id": "T5.mouth_clear", "task": "marina", "tag": "D", "cite": "mouth >= 11 m from the start and the entry lane, room for zone 2 (H p.40 map)", "predicate": "polyline_distance",
     "args": {"point": "anchor:marina.outer_end", "through": ["anchor:entry_gates.start", "gate:entry_gates.gate1", "gate:entry_gates.gate2"]}, "limit": {"min": 11}, "tol": 0.002},
    {"id": "T5.free_red", "task": "marina", "tag": "D", "cite": ">= 1 red slip free of moored boats", "predicate": "count",
     "args": {"select": {"collection": "bays", "task": "marina", "where": {"indicator.color": "red", "occupied": false}}}, "limit": {"min": 1}},
    {"id": "T5.green", "task": "marina", "tag": "H", "cite": "p.54 >= 1 green slip", "predicate": "count",
     "args": {"select": {"collection": "bays", "task": "marina", "where": {"indicator.color": "green"}}}, "limit": {"min": 1}},
    {"id": "T5.green_free", "task": "marina", "tag": "H", "cite": "p.54 green never occupied", "predicate": "implies",
     "args": {"select": {"collection": "bays", "task": "marina"}, "if": {"indicator.color": "green"}, "then": {"occupied": false}}, "limit": {"max": 0}},
    {"id": "T5.occupied_red", "task": "marina", "tag": "H", "cite": "p.54 occupied implies red", "predicate": "implies",
     "args": {"select": {"collection": "bays", "task": "marina"}, "if": {"occupied": true}, "then": {"indicator.color": "red"}}, "limit": {"max": 0}},
    {"id": "T5.lowest_green", "task": "marina", "tag": "D", "cite": "lowest green number unique across piers", "predicate": "argmin_unique",
     "args": {"select": {"collection": "bays", "task": "marina", "where": {"indicator.color": "green"}}, "key": "sign.number"}, "limit": {"min": 1, "max": 1}},
    {"id": "P4.slips", "task": "marina", "tag": "D", "cite": "every green slip entered from the aisle", "predicate": "path",
     "args": {"kind": "slips", "ignore_roles": ["dock_sign", "dock_indicator"], "from": "anchor:marina.approach", "select": {"collection": "bays", "task": "marina", "where": {"indicator.color": "green"}}}, "limit": {"min": 1}},

    {"id": "T6.zone1", "task": "harbor_alert", "tag": "D", "cite": "zone 1 within 2 m of the T3 mark", "predicate": "distance",
     "args": {"a": "anchor:harbor_alert.zone1", "b": "elem:speed_challenge.mark"}, "limit": {"max": 2}},
    {"id": "T6.zone2", "task": "harbor_alert", "tag": "D", "cite": "zone 2 buoy 7-12 m off the marina mouth (H p.40 map)", "predicate": "distance",
     "args": {"a": "elem:harbor_alert.zone2_buoy", "b": "anchor:marina.outer_end"}, "limit": {"min": 7, "max": 12}, "tol": 0.002},
    {"id": "T6.zone2_lane", "task": "harbor_alert", "tag": "D", "cite": "zone 2 buoy >= 15 m from the entry lane (start, gate 1, gate 2)", "predicate": "polyline_distance",
     "args": {"point": "elem:harbor_alert.zone2_buoy", "through": ["anchor:entry_gates.start", "gate:entry_gates.gate1", "gate:entry_gates.gate2"]}, "limit": {"min": 15}, "tol": 0.002},
    {"id": "T6.freq", "task": "harbor_alert", "tag": "H", "cite": "p.56 600/800/1000 Hz +5%", "predicate": "value",
     "args": {"select": {"collection": "tasks", "task": "harbor_alert"}, "path": "semantics.horn.freq_hz"}, "limit": {"min": 600, "max": 1050}},
    {"id": "T6.pattern", "task": "harbor_alert", "tag": "H", "cite": "p.57 one or two blasts", "predicate": "value",
     "args": {"select": {"collection": "tasks", "task": "harbor_alert"}, "path": "semantics.horn.pattern"}, "limit": {"in": ["one", "two"]}},
    {"id": "T6.gap", "task": "harbor_alert", "tag": "H", "cite": "p.57 2 s between signals", "predicate": "value",
     "args": {"select": {"collection": "tasks", "task": "harbor_alert"}, "path": "semantics.horn.program.gap_s"}, "limit": {"min": 2, "max": 2}}
  ]
}
