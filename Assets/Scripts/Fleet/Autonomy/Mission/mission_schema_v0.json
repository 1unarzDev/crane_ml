{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crane.fleet_mission/v0",
  "title": "CRANE fleet mission (task list) v0",
  "description": "Canonical mission format executed closed-loop by Crane.Fleet.Autonomy (MissionSpec.Parse). Units m, rad; world frame = scenario frame (x east, y north, yaw CCW). Poses are [x, y, yaw]. Aliases emitted by Tools/Fleet/harness/promote.py are accepted and mapped (see README 'Mission format'): kind->type, undock->separate, reference_member/actors[0]->agent, follower->docker, leader->target, face_follower->docker_face, face_leader->target_face, coupling 'target.face-docker.face', route_m->route. Unknown task types are rejected; unknown extra fields are ignored (kept for provenance).",
  "type": "object",
  "required": ["schema", "tasks"],
  "properties": {
    "schema": {"const": "crane.fleet_mission/v0"},
    "mission_id": {"type": "string"},
    "initial_couplings": {
      "description": "Couplings already latched and verified at start (pre-assembled groups).",
      "type": "array", "items": {"$ref": "#/$defs/coupling"}
    },
    "initial_payloads": {
      "description": "Payloads resting on decks at start. type = a key of fleet_profile payloads; supporters = rovers whose decks carry it; com = world [x, y].",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "type", "supporters", "com"],
        "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "supporters": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "com": {"$ref": "#/$defs/xy"}}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "pose": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3},
    "face": {"enum": ["front", "rear", "left", "right"]},
    "coupling": {
      "type": "object", "required": ["docker", "target"],
      "properties": {"docker": {"type": "string"}, "docker_face": {"$ref": "#/$defs/face", "default": "front"}, "target": {"type": "string"}, "target_face": {"$ref": "#/$defs/face", "default": "rear"}}
    },
    "common": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "after": {"description": "Task ids that must succeed first. If absent: the latest earlier task naming one of this task's rovers.", "type": "array", "items": {"type": "string"}},
        "retries": {"description": "Re-attempts after a failure (fresh behaviour, replanned). Support and configuration failures are never retried.", "type": "integer", "minimum": 0, "default": 1},
        "timeout": {"description": "Seconds from the first attempt's start.", "type": "number", "default": 300}
      }
    },
    "task": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["goto", "explore", "lift", "rendezvous", "dock", "assemble", "transport", "separate", "handoff", "wait"]}},
      "oneOf": [
        {"properties": {"type": {"const": "goto"}, "agent": {"type": "string", "description": "a rover; its current assembly moves, the goal is this rover's base pose"}, "goal": {"$ref": "#/$defs/pose"}, "route": {"type": "array", "items": {"$ref": "#/$defs/pose"}}, "tol": {"type": "array", "items": {"type": "number"}}, "cruise": {"type": "number"}}, "required": ["agent"], "anyOf": [{"required": ["goal"]}, {"required": ["route"]}]},
        {"properties": {"type": {"const": "explore"}, "agent": {"type": "string"}, "region": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x0, y0, x1, y1]"}, "target": {"type": "string", "description": "object id whose tag must be seen (frame '<id>/base_link')"}, "viewpoints": {"type": "array", "items": {"type": "number"}, "description": "flat [x, y, yaw, x, y, yaw, ...]"}, "dwell": {"type": "number"}}, "required": ["agent", "region", "target"]},
        {"properties": {"type": {"const": "lift"}, "agent": {"type": "string"}, "object": {"type": "string"}, "object_pose": {"$ref": "#/$defs/pose"}, "grasp_offset": {"type": "number"}, "height": {"type": "number"}}, "required": ["agent", "object"]},
        {"properties": {"type": {"const": "rendezvous"}, "target": {"type": "string"}, "docker": {"type": "string"}, "target_face": {"$ref": "#/$defs/face"}, "docker_face": {"$ref": "#/$defs/face"}, "meeting_pose": {"$ref": "#/$defs/pose", "description": "target rover's base pose"}}, "required": ["target", "docker", "meeting_pose"]},
        {"properties": {"type": {"const": "dock"}, "docker": {"type": "string"}, "docker_face": {"$ref": "#/$defs/face"}, "target": {"type": "string"}, "target_face": {"$ref": "#/$defs/face"}}, "required": ["docker", "target"]},
        {"properties": {"type": {"const": "assemble"}, "sequence": {"type": "array", "items": {"$ref": "#/$defs/coupling"}, "minItems": 1}}, "required": ["sequence"]},
        {"properties": {"type": {"const": "transport"}, "agent": {"type": "string"}, "goal": {"$ref": "#/$defs/pose"}, "payload": {"type": "string"}, "tol": {"type": "array", "items": {"type": "number"}}, "cruise": {"type": "number"}}, "required": ["agent", "goal"]},
        {"properties": {"type": {"const": "separate"}, "docker": {"type": "string"}, "docker_face": {"$ref": "#/$defs/face"}, "target": {"type": "string"}, "target_face": {"$ref": "#/$defs/face"}, "clear_distance": {"type": "number"}}, "required": ["docker", "target"]},
        {"properties": {"type": {"const": "handoff"}, "from": {"type": "string"}, "supporters": {"type": "array", "items": {"type": "string"}}, "place_on": {"type": "string", "description": "receiver whose frame defines the placement (default supporters[0])"}, "place_offset": {"$ref": "#/$defs/pose", "description": "payload centre in the place_on frame (default deck centre [0,0,0])"}, "place_pose": {"$ref": "#/$defs/pose", "description": "legacy world placement, used only when tag alignment is disabled"}, "payload": {"type": "string"}, "payload_type": {"type": "string"}, "hold_offset": {"type": "number"}, "clear_distance": {"type": "number", "default": 0.55}}, "required": ["from", "supporters", "payload"]},
        {"properties": {"type": {"const": "wait"}, "agents": {"type": "array", "items": {"type": "string"}}, "duration": {"type": "number"}}}
      ]
    }
  }
}
