<?xml version="1.0"?>
<!-- An agent-written boat (the UrdfTests fixture): a box hull, two thrusters (one tagged the ros2_control way, one by name only)
     and a lidar tagged the Gazebo way. No crane-specific markup. -->
<robot name="minimal_boat">
  <link name="base_link">
    <visual><geometry><box size="1.0 0.6 0.25"/></geometry></visual>
    <collision><geometry><box size="1.0 0.6 0.25"/></geometry></collision>
    <inertial><mass value="20"/><inertia ixx="0.7" ixy="0" ixz="0" iyy="1.8" iyz="0" izz="2.2"/></inertial>
  </link>

  <link name="left_thruster_link">
    <inertial><mass value="0.4"/><inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0006"/></inertial>
  </link>
  <joint name="left_thruster_joint" type="fixed">
    <parent link="base_link"/><child link="left_thruster_link"/>
    <origin xyz="-0.45 0.25 -0.15" rpy="0 1.5708 0"/>
    <ros2_control><param name="thruster">true</param></ros2_control>
  </joint>
  <link name="left_propeller_link">
    <inertial><mass value="0.02"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="left_propeller_joint" type="continuous">
    <parent link="left_thruster_link"/><child link="left_propeller_link"/>
    <origin xyz="0 0 -0.01"/><axis xyz="0 0 1"/>
  </joint>

  <link name="right_thruster_link">
    <inertial><mass value="0.4"/><inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0006"/></inertial>
  </link>
  <joint name="right_thruster_joint" type="fixed">
    <parent link="base_link"/><child link="right_thruster_link"/>
    <origin xyz="-0.45 -0.25 -0.15" rpy="0 1.5708 0"/>
  </joint>
  <link name="right_propeller_link">
    <inertial><mass value="0.02"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="right_propeller_joint" type="continuous">
    <parent link="right_thruster_link"/><child link="right_propeller_link"/>
    <origin xyz="0 0 -0.01"/><axis xyz="0 0 1"/>
  </joint>

  <link name="laser_frame">
    <visual><geometry><cylinder radius="0.05" length="0.07"/></geometry></visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/>
    <origin xyz="0.35 0 0.3"/>
  </joint>
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar"><update_rate>10</update_rate></sensor>
  </gazebo>
</robot>
